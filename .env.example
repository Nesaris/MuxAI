# MuxAI : copier en .env à côté de docker-compose.yml, puis ajuster.

# Adresse et port publiés sur l'hôte.
MUXAI_BIND=127.0.0.1:8787
# 1 derrière un reverse proxy (Caddy, nginx, Traefik) qui transmet l'adresse du client.
MUXAI_TRUST_PROXY=
# 1 pour forcer le cookie « Secure » quand le proxy n'annonce pas le HTTPS.
MUXAI_SECURE=
# Plages des relais de confiance au lieu de 1, pour retrouver l'adresse du client derrière plusieurs relais :
# MUXAI_TRUST_PROXY=172.16.0.0/12
# Clé maîtresse (openssl rand -base64 32) : chiffre la base et les conversations. La perdre, c'est perdre les données.
MUXAI_KEY=
# Noms d'hôte acceptés, séparés par des virgules. Vide : tous.
MUXAI_HOSTS=
# Demandé pour créer le premier compte (administrateur). Vide : MuxAI en tire un
# au démarrage et l'écrit dans son journal (docker compose logs muxai).
MUXAI_SETUP_TOKEN=
